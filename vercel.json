{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/var-historia", "destination": "/var-historia.html" },
    { "source": "/brollopet", "destination": "/brollopet.html" },
    { "source": "/info", "destination": "/info.html" },
    { "source": "/osa", "destination": "/osa.html" },
    { "source": "/onskelista", "destination": "/onskelista.html" },
    { "source": "/presentationer", "destination": "/presentationer.html" },
    { "source": "/bildgalleri", "destination": "/bildgalleri.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
